# ============================================
# YIWU EXPRESS - Environment Configuration
# ============================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local (for local development)
# 2. Copy this file to .env.production (for production server)
# 3. Fill in the appropriate values for each environment
# 4. NEVER commit .env files to Git!
#
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# LOCAL DEVELOPMENT:
# DATABASE_URL="postgresql://postgres:balkhi123@localhost:5432/ecommerce"

# PRODUCTION (dromkok.com):
# DATABASE_URL="postgresql://ecommerce:LzZH5p5SnRtNKfMy@localhost:5432/ecommerce"

DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/ecommerce"

# ============================================
# JWT AUTHENTICATION
# ============================================

# Generate a secure random string (64+ characters)
# Run this to generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET="change_this_to_a_very_long_random_string_at_least_64_characters_long"
JWT_EXPIRES_IN="7d"

# ============================================
# SERVER CONFIGURATION
# ============================================

NODE_ENV="development"
PORT=3001
HOSTNAME="localhost"

# ============================================
# DOMAIN & CORS
# ============================================

# LOCAL:
# NEXT_PUBLIC_API_URL=http://localhost:3001
# ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# PRODUCTION:
# NEXT_PUBLIC_API_URL=https://dromkok.com
# ALLOWED_ORIGINS=https://dromkok.com,https://www.dromkok.com

NEXT_PUBLIC_API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ============================================
# PAYMENT GATEWAYS (Optional)asdfasd
# ============================================

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# PayPal
PAYPAL_CLIENT_ID=xxxxx
PAYPAL_CLIENT_SECRET=xxxxx

# ============================================
# FILE UPLOAD (Optional)
# ============================================

MAX_FILE_SIZE=10485760
UPLOAD_DIR=public/uploads

# ============================================
# AI AUTO-TRANSLATE (Google Gemini 2.5 Flash, free tier)
# ============================================

GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# ============================================
# AI AUTO-TRANSLATE (DeepSeek — Tier 2 failover)
# ============================================

DEEPSEEK_API_KEY=

# ============================================
# AI AUTO-TRANSLATE (Alibaba Qwen — Tier 3 failover)
# ============================================

QWEN_API_KEY=

# ============================================
# AI AUTO-TRANSLATE (Moonshot Kimi AI — Tier 4 failover)
# ============================================

KIMI_API_KEY=

# ============================================
# AI AUTO-TRANSLATE (OpenRouter free tier)
# ============================================

OPENROUTER_API_KEY=
# Optional overrides:
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_REFERER=http://localhost:3000

# ============================================
# AI AUTO-TRANSLATE (Z.ai / Zhipu GLM - Free Flash Tier)
# ============================================

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.7-flash
ZAI_MODEL_VISION=glm-4.6v-flash

# ============================================
# PRODUCT IMAGE MIGRATION & STORAGE
# ============================================

IMAGE_STORAGE=local # "local" or "r2"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ============================================
# IMAGE FINDER EXTERNAL STOCK PHOTO APIS
# ============================================

# Unsplash: https://unsplash.com/developers (50 req/hr free tier)
UNSPLASH_ACCESS_KEY=

# Pexels: https://www.pexels.com/api/ (200 req/hr free tier)
PEXELS_API_KEY=

# Pixabay: https://pixabay.com/api/docs/ (100 req/min free tier)
PIXABAY_API_KEY=


