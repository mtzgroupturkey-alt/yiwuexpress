generator client {
  provider      = "prisma-client-js"
  // Ubuntu 24.04 ships glibc + OpenSSL 3.0. Pinning debian-openssl-3.0.x makes
  // `prisma generate` produce a Linux-compatible engine so `next build` works
  // on the production server (not just the dev machine's `native` engine).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  password           String
  name               String
  companyName        String?
  businessType       String?
  taxId              String?
  country            String?
  phone              String?
  profilePhoto       String?            // Profile photo URL or base64
  role               String             @default("USER") // USER, SUPPLIER, ADMIN
  roleId             String?
  resetToken         String?
  resetTokenExpiry   DateTime?
  isActive           Boolean            @default(true)
  isVerified         Boolean            @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  
  // Supplier reference (only for SUPPLIER role)
  supplierId         String?            @unique
  supplierProfile    SupplierProfile?   @relation(fields: [supplierId], references: [id])
  
  company            CompanyInfo?
  quotes             Quote[]
  shipments          Shipment[]
  permissionRole     PermissionRole?    @relation(fields: [roleId], references: [id])
  customPermissions  UserPermission[]
  activityLogs       ActivityLog[]
  addresses          Address[]
  cart               Cart?
  emailLogs          EmailLog[]
  notifications      Notification[]
  orders             Order[]
  returns            Return[]
  wholesaleInquiries WholesaleInquiry[]
  wishlistItems      WishlistItem[]
  reviews            Review[]
  reviewReplies      ReviewReply[]
  
  @@index([email])
  @@index([role])
}

model Service {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  price       Float
  duration    String?
  coverage    String?
  type        String
  image       String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  quotes      Quote[]
  shipments   Shipment[]
  translations ServiceTranslation[]

  @@map("Service")
}

// Expand-and-Contract: per-locale service copy. Legacy `name`/`description`/
// `coverage`/`duration` on Service remain the source of truth until read paths
// migrate (Phase 3+).
model ServiceTranslation {
  id          String   @id @default(cuid())
  serviceId   String
  locale      String
  name        String
  description String?
  coverage    String?
  duration    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
  @@index([locale])
  @@map("service_translations")
}

model Quote {
  id          String    @id @default(cuid())
  userId      String
  serviceId   String
  serviceType String
  weight      Float?
  dimensions  String?
  origin      String
  destination String
  price       Float?
  validUntil  DateTime?
  status      String    @default("PENDING")
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  service     Service   @relation(fields: [serviceId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Shipment {
  id                String    @id @default(cuid())
  trackingNumber    String    @unique
  userId            String
  serviceId         String
  
  // Order link
  orderId           String?
  orderNumber       String?
  
  // Shipping method
  shippingMethodId  String?
  shippingMethod    ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  
  origin            String
  destination       String
  currentLocation   String?
  status            String    @default("PREPARING")
  statusHistory     Json?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  carrier           String?
  weight            Float?
  dimensions        String?
  notes             String?
  shippedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  service           Service   @relation(fields: [serviceId], references: [id])
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
}

model CompanyInfo {
  id            String   @id @default(cuid())
  userId        String   @unique
  name          String
  address       String?
  phone         String?
  email         String?
  licenseNumber String?
  taxId         String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSettings {
  id                    String   @id @default(cuid())
  companyName           String   @default("Global Trade")
  companyAddress        String?
  companyPhone          String?
  companyEmail          String?
  companyWebsite        String?
  businessLicense       String?
  taxRegistrationNumber String?
  companyDescription    String?
  companyLogo           String?
  companyLogoHeight     Int      @default(40)
  companyFavicon        String?
  primaryColor          String   @default("#1a3a5c")
  accentColor           String   @default("#c9a84c")
  currency              String   @default("USD")
  timezone              String   @default("Asia/Shanghai")
  language              String   @default("en")
  emailNotifications    Boolean  @default(true)
  smsNotifications      Boolean  @default(false)
  maintenanceMode       Boolean  @default(false)
  storeMode             String   @default("WHOLESALE") // WHOLESALE, RETAIL, BOTH
  facebookUrl           String?
  twitterUrl            String?
  linkedinUrl           String?
  instagramUrl          String?
  wechatId              String?
  whatsappNumber        String?
  
  // AI Translation API Keys
  openrouterApiKey      String?
  geminiApiKey          String?
  deepseekApiKey        String?
  qwenApiKey            String?
  kimiApiKey            String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations SystemSettingTranslation[]

  @@map("system_settings")
}

// Expand-and-Contract: per-locale system/company setting text blocks. The
// `key` disambiguates which setting field is translated (e.g. "companyName",
// "companyDescription", "companyAddress"). The legacy columns on SystemSettings
// remain the English source of truth / fallback. Unique per (setting, locale, key).
model SystemSettingTranslation {
  id               String   @id @default(cuid())
  systemSettingId  String
  locale           String
  key              String
  value            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  systemSetting SystemSettings @relation(fields: [systemSettingId], references: [id], onDelete: Cascade)

  @@unique([systemSettingId, locale, key])
  @@index([locale])
  @@map("system_setting_translations")
}

model ContactLocation {
  id        String   @id @default(cuid())
  type      String   @default("HUB") // HEADQUARTERS, HUB
  city      String
  address   String?
  phone     String?
  email     String?
  hours     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  translations ContactLocationTranslation[]

  @@map("contact_locations")
}

// Expand-and-Contract: per-locale contact location copy. Legacy `city`/`address`/
// `hours` on ContactLocation remain the source of truth until read paths migrate.
model ContactLocationTranslation {
  id               String   @id @default(cuid())
  contactLocationId String
  locale           String
  city             String
  address          String?
  hours            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contactLocation ContactLocation @relation(fields: [contactLocationId], references: [id], onDelete: Cascade)

  @@unique([contactLocationId, locale])
  @@index([locale])
  @@map("contact_location_translations")
}

model PermissionRole {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  id        String         @id @default(cuid())
  roleId    String
  resource  String
  canView   Boolean        @default(false)
  canCreate Boolean        @default(false)
  canEdit   Boolean        @default(false)
  canDelete Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  role      PermissionRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource])
}

model UserPermission {
  id        String   @id @default(cuid())
  userId    String
  resource  String
  canView   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource])
}

model Country {
  id                 String             @id @default(cuid())
  code               String             @unique
  name               String
  currency           String
  currencySymbol     String
  flag               String?
  shippingMethods    Json
  customsRules       Json
  paymentMethods     String[]
  deliverySLA        String
  restrictedProducts String[]
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  orders             Order[]
  shippingRates      ShippingRate[]
  wholesaleInquiries WholesaleInquiry[]
  translations       CountryTranslation[]

  @@map("countries")
}

// Expand-and-Contract: per-locale country name. Legacy `name` on Country remains
// the source of truth (and English fallback) until read paths migrate.
model CountryTranslation {
  id        String   @id @default(cuid())
  countryId String
  locale    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, locale])
  @@index([locale])
  @@map("country_translations")
}

model ShippingRate {
  id            String   @id @default(cuid())
  countryId     String
  carrier       String
  serviceType   String
  baseRate      Float
  ratePerKg     Float
  minWeight     Float?
  maxWeight     Float?
  estimatedDays String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  country       Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@map("shipping_rates")
}

model Category {
  id                 String              @id @default(cuid())
  name               String              @unique
  slug               String              @unique
  description        String?
  image              String?
  parentId           String?
  level              Int                 @default(1)
  displayOrder       Int                 @default(0)
  menuOrder          Int                 @default(0)
  isActive           Boolean             @default(true)
  showInMenu         Boolean             @default(true)
  isFeatured         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  icon               String?
  breadcrumbSettings BreadcrumbSetting[]
  parent             Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           Category[]          @relation("CategoryHierarchy")
  attributes         CategoryAttribute[]
  products           Product[]
  translations       CategoryTranslation[]

  @@map("categories")
}

// Expand-and-Contract: per-locale category copy. Legacy `name`/`description`
// on Category remain the source of truth until read paths migrate (Phase 3+).
model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  locale      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
  @@map("category_translations")
}

model Product {
  id                   String              @id @default(cuid())
  sku                  String              @unique
  name                 String
  slug                 String              @unique
  description          String?
  categoryId           String?
  price                Float
  compareAtPrice       Float?
  costPrice            Float?
  purchaseCurrency     String?               // Currency used for purchases (CNY)
  purchasePrice        Float?                // Price in purchase currency
  prices               Json?                 // Multi-currency prices: { "USD": 150.00, "CNY": 1080.00 }
  images               String[]
  videos               String[]            @default([])
  thumbnail            String?
  stock                Int                 @default(0)
  lowStockThreshold    Int                 @default(10)
  hsCode               String?
  weightKg             Float
  dimensions           Json?
  declaredCustomsValue Float?
  countryOfOrigin      String              @default("China")
  material             String?
  fragile              Boolean             @default(false)
  exportRestricted     Boolean             @default(false)
  dangerousGoods       Boolean             @default(false)
  batteryIncluded      Boolean             @default(false)
  requiredExportDocs   String[]
  minOrderQty          Int                 @default(1)
  wholesalePrice       Float?
  metaTitle            String?
  metaDescription      String?
  isActive             Boolean             @default(true)
  isFeatured           Boolean             @default(false)
  featuredOrder        Int                 @default(999)
  isNewArrival         Boolean             @default(false)
  newArrivalOrder      Int                 @default(999)
  isFlashSale          Boolean             @default(false)
  flashSaleOrder       Int                 @default(999)
  flashSalePrice       Float?
  flashSaleStart       DateTime?
  flashSaleEnd         DateTime?
  flashSaleStock       Int?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  attributeValues      AttributeValue[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  variants             ProductVariant[]
  category             Category?           @relation(fields: [categoryId], references: [id])
  suppliers            ProductSupplier[]
  purchaseOrderItems   PurchaseOrderItem[]
  wishlistItems        WishlistItem[]
  reviews              Review[]
  translations         ProductTranslation[]

  @@map("products")
}

// Expand-and-Contract: per-locale product copy. Legacy `name`/`description`
// on Product remain the source of truth until read paths migrate (Phase 3+).
model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String
  locale      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
  @@map("product_translations")
}

model Order {
  id                 String           @id @default(cuid())
  orderNumber        String           @unique
  userId             String
  customerName       String
  customerEmail      String
  customerPhone      String
  companyName        String?
  shippingAddress    String
  shippingCity       String
  shippingState      String?
  shippingPostalCode String
  shippingCountryId  String
  billingAddress     String?
  billingCity        String?
  billingState       String?
  billingPostalCode  String?
  billingCountry     String?
  status             String           @default("PENDING")
  paymentMethod      String
  paymentStatus      String           @default("UNPAID")
  paidAt             DateTime?
  subtotal           Float
  shippingFee        Float
  tax                Float            @default(0)
  discount           Float            @default(0)
  total              Float
  currency           String           @default("USD") // Sales currency
  exchangeRate       Float?           // Rate used at time of order
  purchaseCost       Float?           // Cost in base currency
  profit             Float?           // Profit in base currency
  profitMargin       Float?           // Profit percentage
  
  // Carrier type: COMPANY or CUSTOMER
  carrierType        String           @default("COMPANY")
  customerCarrier    String?
  customerCarrierContact String?
  customerCarrierTracking String?
  customerCarrierNotes String?
  
  carrier            String?
  trackingNumber     String?
  shippingMethod     String?
  shippingCost       Float?
  shippedAt          DateTime?
  estimatedDelivery  DateTime?
  actualDelivery     DateTime?
  trackingHistory    Json[]
  customsStatus      String?
  customsDocs        Json?
  
  // Container relation
  containerId        String?
  container          Container?       @relation(fields: [containerId], references: [id])
  containerNumber    String?
  
  customerNotes      String?
  adminNotes         String?
  hasException       Boolean          @default(false)
  exceptionType      String?
  exceptionNotes     String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  emailLogs          EmailLog[]
  exceptions         OrderException[]
  items              OrderItem[]
  shippingCountry    Country          @relation(fields: [shippingCountryId], references: [id])
  user               User             @relation(fields: [userId], references: [id])
  returns            Return[]

  @@index([containerId])
  @@map("orders")
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  productId         String
  variantId         String?
  productName       String
  productSku        String
  productImage      String?
  variantAttributes Json?
  quantity          Int
  price             Float
  total             Float
  status            String          @default("PENDING")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])
  variant           ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model OrderException {
  id          String    @id @default(cuid())
  orderId     String
  type        String
  description String
  status      String    @default("OPEN")
  resolution  String?
  createdBy   String?
  resolvedBy  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime  @updatedAt
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_exceptions")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model WholesaleInquiry {
  id                   String    @id @default(cuid())
  inquiryNumber        String    @unique
  userId               String
  companyName          String
  businessType         String
  country              String
  countryId            String?
  products             Json
  paymentTerms         String
  shippingTerms        String
  preferredShipping    String
  requiredDeliveryDate DateTime?
  targetPrice          Float?
  estimatedOrderValue  Float?
  status               String    @default("INQUIRY_SUBMITTED")
  quotedPrice          Float?
  quotedBy             String?
  quotedAt             DateTime?
  quoteValidUntil      DateTime?
  quoteNotes           String?
  negotiationHistory   Json[]
  invoiceNumber        String?
  invoiceUrl           String?
  invoicedAt           DateTime?
  convertedToOrderId   String?
  convertedAt          DateTime?
  customerNotes        String?
  adminNotes           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  shippingCountry      Country?  @relation(fields: [countryId], references: [id])
  user                 User      @relation(fields: [userId], references: [id])

  @@map("wholesale_inquiries")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String?
  fullName     String
  phone        String
  company      String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  country      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  sku                String              @unique
  attributes         Json
  price              Float
  comparePrice       Float?
  costPrice          Float?
  stock              Int                 @default(0)
  lowStockThreshold  Int                 @default(10)
  images             String[]
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attributeValues    AttributeValue[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  tieredPrices       TieredPrice[]
  purchaseOrderItems PurchaseOrderItem[] // NEW

  @@map("product_variants")
}

model TieredPrice {
  id          String         @id @default(cuid())
  variantId   String
  minQuantity Int
  maxQuantity Int?
  price       Float
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("tiered_prices")
}

model Return {
  id               String    @id @default(cuid())
  orderId          String
  userId           String
  returnNumber     String    @unique
  reason           String
  description      String?
  images           String[]
  items            Json
  status           String    @default("REQUESTED")
  returnCarrier    String?
  returnTracking   String?
  returnShippedAt  DateTime?
  returnReceivedAt DateTime?
  refundAmount     Float?
  refundMethod     String?
  refundReason     String?
  refundedAt       DateTime?
  adminNotes       String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id])

  @@map("returns")
}

model EmailLog {
  id          String    @id @default(cuid())
  orderId     String?
  userId      String?
  recipient   String
  subject     String
  template    String
  content     String
  status      String
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  order       Order?    @relation(fields: [orderId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@map("email_logs")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("activity_logs")
}

model HeroSlide {
  id               String   @id @default(cuid())
  title            String
  subtitle         String?
  description      String?
  imageUrl         String
  mobileImageUrl   String?
  productImageUrl  String?
  badgeText        String?
  badgeColor       String?
  ctaText          String
  ctaLink          String
  secondaryCtaText String?
  secondaryCtaLink String?
  overlayColor     String?
  textColor        String?
  alignment        String   @default("left") // left, center, right
  displayOrder     Int      @default(0)
  isActive         Boolean  @default(true)
  slideDuration    Int      @default(5)
  motionType       String   @default("slide")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  translations HeroSlideTranslation[]

  @@index([displayOrder])
  @@index([isActive])
  @@map("hero_slides")
}

// Expand-and-Contract: per-locale hero slide copy. Legacy `title`/`subtitle`/
// `description`/`badgeText`/`ctaText`/`secondaryCtaText` on HeroSlide remain the
// source of truth until read paths migrate (Phase 3+).
model HeroSlideTranslation {
  id               String   @id @default(cuid())
  heroSlideId      String
  locale           String
  title            String
  subtitle         String?
  description      String?
  badgeText        String?
  ctaText          String
  secondaryCtaText String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  heroSlide HeroSlide @relation(fields: [heroSlideId], references: [id], onDelete: Cascade)

  @@unique([heroSlideId, locale])
  @@index([locale])
  @@map("hero_slide_translations")
}

model Attribute {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  type         AttributeType
  options      Json?               // For SELECT/MULTISELECT: ["Red", "Blue"]
  colorOptions Json?               // For COLOR/COLOR_MULTI: [{"label":"Red","value":"#FF0000"}]
  placeholder  String?
  helperText   String?
  isRequired   Boolean             @default(false)
  isFilterable Boolean             @default(true)
  isVariant    Boolean             @default(false)
  displayOrder Int                 @default(0)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  values       AttributeValue[]
  categories   CategoryAttribute[]
  translations AttributeTranslation[]

  @@map("attributes")
}

// Expand-and-Contract: per-locale attribute name. Legacy `name` on Attribute
// remains the source of truth until read paths migrate (Phase 3+).
model AttributeTranslation {
  id         String   @id @default(cuid())
  attributeId String
  locale     String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, locale])
  @@index([locale])
  @@map("attribute_translations")
}

model CategoryAttribute {
  id           String    @id @default(cuid())
  categoryId   String
  attributeId  String
  displayOrder Int       @default(0)
  isVisible    Boolean   @default(true)
  isRequired   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  attribute    Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
  @@map("category_attributes")
}

model AttributeValue {
  id          String          @id @default(cuid())
  attributeId String
  productId   String
  variantId   String?
  value       String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  attribute   Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  translations AttributeValueTranslation[]

  @@index([productId])
  @@index([attributeId])
  @@map("attribute_values")
}

// Expand-and-Contract: per-locale attribute value (e.g. "Red", "10kg"). Legacy
// `value` on AttributeValue remains the source of truth until read paths migrate.
model AttributeValueTranslation {
  id               String   @id @default(cuid())
  attributeValueId String
  locale           String
  value            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([attributeValueId, locale])
  @@index([locale])
  @@map("attribute_value_translations")
}

model BreadcrumbSetting {
  id             String    @id @default(cuid())
  pageType       String
  pageSlug       String?
  categoryId     String?
  imageUrl       String
  mobileImageUrl String?
  overlayColor   String?
  title          String?
  subtitle       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations   PageBannerTranslation[]

  @@unique([pageType, pageSlug])
  @@unique([pageType, categoryId])
  @@map("breadcrumb_settings")
}

// Expand-and-Contract: per-locale page banner (breadcrumb) copy. Legacy `title`/
// `subtitle` on BreadcrumbSetting remain the source of truth until read paths
// migrate (Phase 3+). Named PageBannerTranslation per the localization roadmap.
model PageBannerTranslation {
  id                  String   @id @default(cuid())
  pageBannerId        String
  locale              String
  title               String?
  subtitle            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  pageBanner BreadcrumbSetting @relation(fields: [pageBannerId], references: [id], onDelete: Cascade)

  @@unique([pageBannerId, locale])
  @@index([locale])
  @@map("page_banner_translations")
}

enum AttributeType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  MULTISELECT
  COLOR
  COLOR_MULTI
  FILE
  URL
  CHECKBOX
  DATE
}


// ============================================
// PURCHASE MANAGEMENT SYSTEM
// ============================================

// ============================================================
// SUPPLIER PROFILE (for SUPPLIER role users)
// ============================================================
model SupplierProfile {
  id             String              @id @default(cuid())
  companyName    String
  businessType   String?             // MANUFACTURER, WHOLESALER, DISTRIBUTOR
  taxId          String?
  vatNumber      String?
  phone          String?
  address        String?
  website        String?
  description    String?
  logo           String?
  paymentTerms   String?             // "net30", "net60", "prepayment"
  currency       String              @default("USD")
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  
  // One-to-one with User
  user           User?
  
  @@map("supplier_profiles")
}

model Supplier {
  id             String              @id @default(cuid())
  name           String
  companyName    String?
  email          String?
  phone          String?
  address        String?
  contactPerson  String?
  taxId          String?
  paymentTerms   String?             // "net30", "net60", "prepayment"
  currency       String              @default("USD")
  notes          String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  purchaseOrders PurchaseOrder[]
  products       ProductSupplier[]
  translations   SupplierTranslation[]

  @@map("suppliers")
}

// Expand-and-Contract: per-locale supplier copy. Legacy `name`/`notes` on Supplier
// remain the source of truth (and English fallback) until read paths migrate.
model SupplierTranslation {
  id          String   @id @default(cuid())
  supplierId  String
  locale      String
  name        String
  description String?
  profileText String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, locale])
  @@index([locale])
  @@map("supplier_translations")
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  poNumber         String              @unique
  supplierId       String
  status           String              @default("DRAFT") // DRAFT, PENDING, SENT, CONFIRMED, SHIPPED, RECEIVED, CANCELLED, CLOSED
  subtotal         Float
  tax              Float
  shippingCost     Float
  discount         Float               @default(0)
  total            Float
  currency         String              @default("USD")
  exchangeRate     Float?              // Rate used at time of purchase
  costInBase       Float?              // Total cost converted to base currency
  orderDate        DateTime            @default(now())
  expectedDelivery DateTime?
  receivedDate     DateTime?
  paidDate         DateTime?
  notes            String?
  internalNotes    String?
  isUrgent         Boolean             @default(false)
  isPaid           Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items            PurchaseOrderItem[]
  payments         SupplierPayment[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String          @id @default(cuid())
  purchaseOrderId   String
  productId         String?
  variantId         String?         // NEW: Reference to specific variant
  productName       String          // Snapshot
  productSku        String          // Snapshot
  variantName       String?         // NEW: Variant description (e.g., "10-inch, Silver")
  variantAttributes Json?           // NEW: { "Size": "10\"", "Color": "Silver" }
  quantity          Int
  unitPrice         Float
  total             Float
  receivedQuantity  Int             @default(0)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  purchaseOrder     PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id])
  variant           ProductVariant? @relation(fields: [variantId], references: [id]) // NEW

  @@map("purchase_order_items")
}

model SupplierPayment {
  id              String        @id @default(cuid())
  purchaseOrderId String
  amount          Float
  currency        String        @default("USD")
  paymentMethod   String        // "bank_transfer", "cash", "check", "paypal"
  paymentDate     DateTime
  reference       String?       // Payment reference number
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("supplier_payments")
}

model ProductSupplier {
  id          String   @id @default(cuid())
  productId   String
  supplierId  String
  supplierSku String?  // Supplier's SKU
  costPrice   Float    // Purchase price from supplier
  leadTime    Int?     // Days to deliver
  isPreferred Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}


// ============================================
// MULTI-CURRENCY MANAGEMENT SYSTEM
// ============================================

model Currency {
  id                    String    @id @default(cuid())
  code                  String    @unique // USD, CNY, EUR, RUB, etc.
  name                  String    // US Dollar, Chinese Yuan, etc.
  symbol                String    // $, ¥, €, ₽, etc.
  symbolPosition        String    @default("before") // before, after
  decimalPlaces         Int       @default(2)
  isBase                Boolean   @default(false) // Base currency for reporting
  isActive              Boolean   @default(true)
  exchangeRate          Float?    // Rate against base currency
  exchangeRateUpdatedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("currencies")
}

model ExchangeRateHistory {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  date         DateTime @default(now())
  source       String?  // "manual", "api", "admin"
  notes        String?
  createdAt    DateTime @default(now())

  @@index([fromCurrency, toCurrency, date])
  @@map("exchange_rate_history")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ============================================================
// SHIPPING METHOD - Dynamic shipping modes
// ============================================================
model ShippingMethod {
  id                    String   @id @default(cuid())
  name                  String   // "Sea Freight", "Truck", "Train", "Air", "Multi-modal"
  slug                  String   @unique // "sea", "truck", "train", "air", "multi-modal"
  description           String?
  
  // Default statuses for this shipping method
  defaultStatuses       Json?    // ["LOADING", "IN_TRANSIT", "CUSTOMS", "DELIVERED"]
  
  // Custom statuses allowed
  customStatusesAllowed Boolean  @default(true)
  
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  containers            Container[]
  shipments             Shipment[]
  translations          ShippingMethodTranslation[]

  @@map("shipping_methods")
}

// Expand-and-Contract: per-locale shipping method copy. Legacy `name`/
// `description` on ShippingMethod remain the source of truth until read paths
// migrate (Phase 3+).
model ShippingMethodTranslation {
  id          String   @id @default(cuid())
  shippingMethodId String
  locale      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)

  @@unique([shippingMethodId, locale])
  @@index([locale])
  @@map("shipping_method_translations")
}

// ============================================================
// CONTAINER - With dynamic shipping method
// ============================================================
model Container {
  id                  String           @id @default(cuid())
  containerNumber     String           @unique
  shippingMethodId    String?
  
  vesselName          String?
  voyageNumber        String?
  
  methodDetails       Json?            // { "route": "Yiwu-Moscow", "transitPoints": [...] }
  
  status              String           @default("PLANNING")
  statusHistory       Json?            // Array of { status, timestamp, location, note }
  
  origin              String
  destination         String
  transitPoints       Json?            // ["Yiwu", "Almaty", "Moscow"]
  
  estimatedDeparture  DateTime?
  estimatedArrival    DateTime?
  actualDeparture     DateTime?
  actualArrival       DateTime?
  
  containerType       String?          // 20ft, 40ft, 40ft HC
  weight              Float?
  volume              Float?
  
  notes               String?
  
  shippingMethod      ShippingMethod?  @relation(fields: [shippingMethodId], references: [id])
  orders              Order[]
  
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([containerNumber])
  @@index([status])
  @@map("containers")
}

model Review {
  id                 String        @id @default(cuid())
  productId          String
  userId             String
  rating             Int           // 1 to 5
  title              String
  comment            String
  images             String[]      // Array of image URLs
  isVerifiedPurchase Boolean       @default(false)
  isApproved         Boolean       @default(false)
  helpfulCount       Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies            ReviewReply[]

  @@index([productId])
  @@index([userId])
  @@index([isApproved])
  @@map("reviews")
}

model ReviewReply {
  id           String   @id @default(cuid())
  reviewId     String
  userId       String
  comment      String
  isAdminReply Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  review       Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([userId])
  @@map("review_replies")
}

model Testimonial {
  id         String   @id @default(cuid())
  name       String
  company    String
  role       String
  quote      String
  rating     Int      @default(5)
  avatar     String?  // Avatar image URL
  image      String?  // Secondary customer photo
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  translations TestimonialTranslation[]

  @@map("testimonials")
}

// Expand-and-Contract: per-locale testimonial copy. Legacy `quote`/`role`/
// `company` on Testimonial remain the source of truth until read paths migrate
// (Phase 3+). Note `name` stays single-language (person's name, not translated).
model TestimonialTranslation {
  id          String   @id @default(cuid())
  testimonialId String
  locale      String
  quote       String
  role        String?
  company     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@unique([testimonialId, locale])
  @@index([locale])
  @@map("testimonial_translations")
}

model Deployment {
  id              String   @id @default(cuid())
  deploymentNumber String
  environment     String
  status          String   @default("in-progress")
  type            String   @default("deploy") // deploy, rollback
  branch          String?
  commitHash      String?
  commitMessage   String?
  triggeredBy     String?
  metadata        Json?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  duration        Int?
  logs            String?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("deployments")
}

// Email templates: localized transactional text blocks (checkout confirmation,
// order status, tracking alerts). The legacy `subject`/`bodyHtml`/`bodyText`
// columns hold the canonical English content and act as the fallback. `type`
// is the stable key used by the mailer (e.g. "orderConfirmation").
model EmailTemplate {
  id        String   @id @default(cuid())
  type      String   @unique
  name      String
  subject   String
  bodyHtml  String
  bodyText  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations EmailTemplateTranslation[]

  @@map("email_templates")
}

// Expand-and-Contract: per-locale email copy. Legacy columns on EmailTemplate
// remain the English source of truth / fallback.
model EmailTemplateTranslation {
  id         String   @id @default(cuid())
  emailTemplateId String
  locale     String
  subject    String
  bodyHtml   String
  bodyText   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  emailTemplate EmailTemplate @relation(fields: [emailTemplateId], references: [id], onDelete: Cascade)

  @@unique([emailTemplateId, locale])
  @@index([locale])
  @@map("email_template_translations")
}

