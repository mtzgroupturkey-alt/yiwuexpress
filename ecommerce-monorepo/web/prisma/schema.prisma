// ============================================
// PURCHASE MANAGEMENT SYSTEM
// ============================================

// ============================================================
// SUPPLIER PROFILE (for SUPPLIER role users)
// ============================================================
model SupplierProfile {
  id           String   @id @default(cuid())
  companyName  String
  businessType String? // MANUFACTURER, WHOLESALER, DISTRIBUTOR
  taxId        String?
  vatNumber    String?
  phone        String?
  address      String?
  website      String?
  description  String?
  logo         String?
  paymentTerms String? // "net30", "net60", "prepayment"
  currency     String   @default("USD")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // One-to-one with User
  user User?

  @@map("supplier_profiles")
}

model Supplier {
  id                String                @id @default(cuid())
  name              String
  companyName       String?
  email             String?
  phone             String?
  address           String?
  contactPerson     String?
  taxId             String?
  paymentTerms      String? // "net30", "net60", "prepayment"
  currency          String                @default("USD")
  notes             String?
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  purchaseOrders    PurchaseOrder[]
  returnsToSupplier ReturnToSupplier[]
  products          ProductSupplier[]
  translations      SupplierTranslation[]

  @@map("suppliers")
}

// Expand-and-Contract: per-locale supplier copy. Legacy `name`/`notes` on Supplier
// remain the source of truth (and English fallback) until read paths migrate.
model SupplierTranslation {
  id          String   @id @default(cuid())
  supplierId  String
  locale      String
  name        String
  description String?
  profileText String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, locale])
  @@index([locale])
  @@map("supplier_translations")
}

model PurchaseOrder {
  id                     String              @id @default(cuid())
  poNumber               String              @unique
  supplierId             String
  status                 String              @default("DRAFT") // DRAFT, PENDING, SENT, CONFIRMED, SHIPPED, RECEIVED, CANCELLED, CLOSED
  subtotal               Float
  tax                    Float
  shippingCost           Float
  discount               Float               @default(0)
  total                  Float
  currency               String              @default("USD")
  exchangeRate           Float? // Rate used at time of purchase
  costInBase             Float? // Total cost converted to base currency
  orderDate              DateTime            @default(now())
  expectedDelivery       DateTime?
  receivedDate           DateTime?
  paidDate               DateTime?
  notes                  String?
  internalNotes          String?
  isUrgent               Boolean             @default(false)
  isPaid                 Boolean             @default(false)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  supplier               Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items                  PurchaseOrderItem[]
  payments               SupplierPayment[]
  containerId            String?
  container              Container?          @relation(fields: [containerId], references: [id])
  destinationWarehouseId String?
  destinationWarehouse   Warehouse?          @relation(fields: [destinationWarehouseId], references: [id])
  directToBelarus        Boolean             @default(false)

  // Purchase destination lifecycle
  purchaseDestination    PurchaseDestination @default(CHINA_WAREHOUSE)
  targetCustomerId       String?
  targetCustomer         User?               @relation("TargetCustomerPOs", fields: [targetCustomerId], references: [id])
  shippingAddress        Json?
  linkedOrderId          String?             @unique
  linkedOrder            Order?              @relation("POLinkedOrder", fields: [linkedOrderId], references: [id])
  singleContainer        Container[]         @relation("ContainerSinglePO")

  containerItems         ContainerItem[]
  returnsToSupplier      ReturnToSupplier[]

  @@index([destinationWarehouseId])
  @@index([targetCustomerId])
  @@index([purchaseDestination])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String          @id @default(cuid())
  purchaseOrderId   String
  productId         String?
  variantId         String? // NEW: Reference to specific variant
  productName       String // Snapshot
  productSku        String // Snapshot
  variantName       String? // NEW: Variant description (e.g., "10-inch, Silver")
  variantAttributes Json? // NEW: { "Size": "10\"", "Color": "Silver" }
  quantity          Int
  unitPrice         Float
  total             Float
  receivedQuantity  Int             @default(0)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  purchaseOrder     PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id])
  variant           ProductVariant? @relation(fields: [variantId], references: [id]) // NEW

  @@map("purchase_order_items")
}

model SupplierPayment {
  id              String        @id @default(cuid())
  purchaseOrderId String
  amount          Float
  currency        String        @default("USD")
  paymentMethod   String // "bank_transfer", "cash", "check", "paypal"
  paymentDate     DateTime
  reference       String? // Payment reference number
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("supplier_payments")
}

model ProductSupplier {
  id          String   @id @default(cuid())
  productId   String
  supplierId  String
  supplierSku String? // Supplier's SKU
  costPrice   Float // Purchase price from supplier
  leadTime    Int? // Days to deliver
  isPreferred Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

// ============================================
// MULTI-CURRENCY MANAGEMENT SYSTEM
// ============================================

model Currency {
  id                    String    @id @default(cuid())
  code                  String    @unique // USD, CNY, EUR, RUB, etc.
  name                  String // US Dollar, Chinese Yuan, etc.
  symbol                String // $, ¥, €, ₽, etc.
  symbolPosition        String    @default("before") // before, after
  decimalPlaces         Int       @default(2)
  isBase                Boolean   @default(false) // Base currency for reporting
  isActive              Boolean   @default(true)
  exchangeRate          Float? // Rate against base currency
  exchangeRateUpdatedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("currencies")
}

model ExchangeRateHistory {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  date         DateTime @default(now())
  source       String? // "manual", "api", "admin"
  notes        String?
  createdAt    DateTime @default(now())

  @@index([fromCurrency, toCurrency, date])
  @@map("exchange_rate_history")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ============================================================
// SHIPPING METHOD - Dynamic shipping modes
// ============================================================

// Expand-and-Contract: per-locale shipping method copy. Legacy `name`/
// `description` on ShippingMethod remain the source of truth until read paths
// migrate (Phase 3+).

// ============================================================
// LOGISTICS & SHIPPING (SIMPLIFIED CONTAINER-CENTRIC SYSTEM)
// ============================================================

enum RouteType {
  SEA
  AIR
  LAND
  MULTI
}

enum ContainerStatus {
  PLANNING
  LOADING
  DEPARTED
  IN_TRANSIT
  AT_CUSTOMS
  CUSTOMS_CLEARED
  ARRIVED
  WAREHOUSE_RECEIVED
  DELIVERED
  CANCELLED
}

enum WarehouseType {
  PROCUREMENT
  DISTRIBUTION
  TRANSIT
  RETURN
}

enum ZoneType {
  RECEIVING
  STORAGE
  PICKING
  PACKING
  SHIPPING
  DAMAGED
  RETURNS
  STAGING
}

enum AlertStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

enum StockMovementType {
  PURCHASE_RECEIPT
  CONTAINER_DISPATCH
  CONTAINER_RECEIPT
  ORDER_RESERVED
  ORDER_FULFILLED
  ORDER_CANCELLED_RESTOCK
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  DIRECT_CONTAINER_DELIVERY
  RESERVATION_EXPIRED
  // Legacy aliases
  ORDER_DECREMENT
  PO_RECEIVE
  RETURN
}

enum PurchaseDestination {
  CHINA_WAREHOUSE
  DIRECT_TO_CONTAINER
  DIRECT_TO_CUSTOMER
}

enum LoadingType {
  FROM_WAREHOUSE
  DIRECT_FROM_PO
  DIRECT_TO_CUSTOMER
  MIXED
}

enum CustomsStatus {
  PENDING
  DOCS_SUBMITTED
  INSPECTION
  DUTIES_PAID
  CLEARED
  REJECTED
}

enum AllocMethod {
  VALUE
  WEIGHT
  CBM
  UNITS
}

enum OrderSalesType {
  RETAIL
  WHOLESALE
  DIRECT_CONTAINER
}

enum TransferStatus {
  DRAFT
  PENDING_APPROVAL
  IN_TRANSIT
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum ReturnStatus {
  DRAFT
  APPROVED
  PACKED
  SHIPPED
  DELIVERED
  REFUNDED
  CANCELLED
}

enum RefundMethod {
  ORIGINAL_PAYMENT
  STORE_CREDIT
  REPLACEMENT
}

model Carrier {
  id         String      @id @default(cuid())
  name       String
  code       String      @unique
  isActive   Boolean     @default(true)
  containers Container[]
  routes     Route[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("carriers")
}

model Agent {
  id         String         @id @default(cuid())
  name       String
  email      String?
  phone      String?
  company    String?
  isActive   Boolean        @default(true)
  containers Container[]
  payments   AgentPayment[]
  costItems  CostItem[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("shipping_agents")
}

model Container {
  id              String          @id @default(cuid())
  containerNumber String          @unique
  carrierId       String?
  carrier         Carrier?        @relation(fields: [carrierId], references: [id])
  agentId         String?
  agent           Agent?          @relation(fields: [agentId], references: [id])
  routeType       RouteType       @default(SEA)
  origin          String
  destination     String
  departureDate   DateTime?
  arrivalDate     DateTime?
  costItems       CostItem[]
  agentPayments   AgentPayment[]
  totalCost       Float?          @default(0)
  totalAgentFees  Float?          @default(0)
  status          ContainerStatus @default(PLANNING)
  notes           String?

  // Multi-warehouse & Logistics enhancements
  sourceWarehouseId      String?
  sourceWarehouse        Warehouse?    @relation("SourceContainers", fields: [sourceWarehouseId], references: [id])
  destinationWarehouseId String?
  destinationWarehouse   Warehouse?    @relation("DestinationContainers", fields: [destinationWarehouseId], references: [id])
  loadingType            LoadingType   @default(FROM_WAREHOUSE)
  customsStatus          CustomsStatus @default(PENDING)
  allocationMethod       AllocMethod   @default(VALUE)

  // Flow 3: Direct Container Sale (B2B - No Belarus Warehouse)
  shipToCustomerDirectly Boolean @default(false)
  directCustomerId       String?
  directOrderId          String?

  // Direct & Linked Assignment
  purchaseOrderId        String?
  purchaseOrder          PurchaseOrder?  @relation("ContainerSinglePO", fields: [purchaseOrderId], references: [id])
  customerOrderId        String?
  customerOrder          Order?          @relation("ContainerSingleOrder", fields: [customerOrderId], references: [id])

  items          ContainerItem[]
  purchaseOrders PurchaseOrder[]
  orders         Order[]
  routes         Route[]
  stockTransfers StockTransfer[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@map("containers")
}

model CostItem {
  id               String    @id @default(cuid())
  containerId      String
  container        Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  agentId          String?
  agent            Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  title            String
  amount           Float
  currency         String    @default("USD")
  notes            String?
  isPaid           Boolean   @default(false)
  paidDate         DateTime?
  paidAmount       Float?
  paymentReference String?
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([containerId])
  @@index([agentId])
  @@map("cost_items")
}

model AgentPayment {
  id            String    @id @default(cuid())
  agentId       String
  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  containerId   String?
  container     Container? @relation(fields: [containerId], references: [id], onDelete: SetNull)
  amount        Float
  currency      String    @default("USD")
  description   String?
  paymentDate   DateTime  @default(now())
  paymentMethod String?
  reference     String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([agentId])
  @@index([containerId])
  @@map("agent_payments")
}

model Route {
  id          String    @id @default(cuid())
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  type        RouteType
  legOrder    Int
  origin      String
  destination String
  distance    Float?
  duration    Float?
  carrierId   String?
  carrier     Carrier?  @relation(fields: [carrierId], references: [id])
  cost        Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("routes")
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  userId             String
  rating             Int // 1 to 5
  title              String
  comment            String
  images             String[] // Array of image URLs
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(false)
  helpfulCount       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies ReviewReply[]

  @@index([productId])
  @@index([userId])
  @@index([isApproved])
  @@map("reviews")
}

model ReviewReply {
  id           String   @id @default(cuid())
  reviewId     String
  userId       String
  comment      String
  isAdminReply Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([userId])
  @@map("review_replies")
}

model Testimonial {
  id         String   @id @default(cuid())
  name       String
  company    String
  role       String
  quote      String
  rating     Int      @default(5)
  avatar     String? // Avatar image URL
  image      String? // Secondary customer photo
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  translations TestimonialTranslation[]

  @@map("testimonials")
}

// Expand-and-Contract: per-locale testimonial copy. Legacy `quote`/`role`/
// `company` on Testimonial remain the source of truth until read paths migrate
// (Phase 3+). Note `name` stays single-language (person's name, not translated).
model TestimonialTranslation {
  id            String   @id @default(cuid())
  testimonialId String
  locale        String
  quote         String
  role          String?
  company       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@unique([testimonialId, locale])
  @@index([locale])
  @@map("testimonial_translations")
}

model Deployment {
  id               String    @id @default(cuid())
  deploymentNumber String
  environment      String
  status           String    @default("in-progress")
  type             String    @default("deploy") // deploy, rollback
  branch           String?
  commitHash       String?
  commitMessage    String?
  triggeredBy      String?
  metadata         Json?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  duration         Int?
  logs             String?
  error            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("deployments")
}

// Email templates: localized transactional text blocks (checkout confirmation,
// order status, tracking alerts). The legacy `subject`/`bodyHtml`/`bodyText`
// columns hold the canonical English content and act as the fallback. `type`
// is the stable key used by the mailer (e.g. "orderConfirmation").
model EmailTemplate {
  id        String   @id @default(cuid())
  type      String   @unique
  name      String
  subject   String
  bodyHtml  String
  bodyText  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations EmailTemplateTranslation[]

  @@map("email_templates")
}

// Expand-and-Contract: per-locale email copy. Legacy columns on EmailTemplate
// remain the English source of truth / fallback.
model EmailTemplateTranslation {
  id              String   @id @default(cuid())
  emailTemplateId String
  locale          String
  subject         String
  bodyHtml        String
  bodyText        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  emailTemplate EmailTemplate @relation(fields: [emailTemplateId], references: [id], onDelete: Cascade)

  @@unique([emailTemplateId, locale])
  @@index([locale])
  @@map("email_template_translations")
}

model CustomerPayment {
  id            String   @id @default(cuid())
  orderId       String
  amount        Float
  currency      String   @default("USD")
  paymentMethod String // "stripe", "paypal", "bank_transfer", "cash"
  paymentDate   DateTime @default(now())
  reference     String? // Transaction or reference number
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("customer_payments")
}

model JournalEntry {
  id          String   @id @default(cuid())
  entryNumber String   @unique
  date        DateTime @default(now())
  type        String // "DEBIT", "CREDIT"
  category    String // "REVENUE", "COGS", "EXPENSE", "ASSET", "LIABILITY", "EQUITY"
  account     String // e.g., "Accounts Receivable", "Accounts Payable", "Cash", "Sales Revenue"
  amount      Float
  currency    String   @default("USD")
  description String
  reference   String? // Reference to orderId, poId, invoiceId, etc.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([account])
  @@map("journal_entries")
}

model PageContent {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String // Rich HTML content
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean  @default(true)
  author      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@map("page_contents")
}

model VerificationDocument {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // "BUSINESS_LICENSE" | "TAX_CERTIFICATE" | "ID_CARD" | "IMPORT_EXPORT_LICENSE"
  fileUrl    String
  fileName   String
  fileSize   Int      @default(0)
  status     String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  notes      String?
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("verification_documents")
}

model Discount {
  id           String  @id @default(cuid())
  code         String  @unique
  description  String?
  discountType String // "PERCENTAGE", "FIXED_AMOUNT", "FREE_SHIPPING"
  value        Float
  targetMode   String  @default("BOTH") // "RETAIL", "WHOLESALE", "BOTH"

  minSpend          Float?
  minQuantity       Int?
  maxDiscountAmount Float?
  usageLimit        Int?
  usedCount         Int    @default(0)
  perUserLimit      Int?   @default(1)

  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("discounts")
}

model ContractPrice {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customPrice Float
  currency    String    @default("USD")
  minQuantity Int       @default(1)
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("contract_prices")
}

model StockMovement {
  id          String             @id @default(cuid())
  productId   String?
  variantId   String?
  warehouseId String?
  warehouse   Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  type        StockMovementType?
  typeString  String? // legacy fallback
  quantity    Int // Positive for additions, negative for deductions
  unitCost    Float?
  totalCost   Float?
  reference   String? // Order Number, PO Number, Container Number, Transfer Number, etc.
  containerId String?
  container   Container?         @relation(fields: [containerId], references: [id], onDelete: SetNull)
  transferId  String?
  transfer    StockTransfer?     @relation(fields: [transferId], references: [id], onDelete: SetNull)
  returnId    String?
  orderId     String?
  order       Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime           @default(now())

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([warehouseId])
  @@index([type])
  @@index([containerId])
  @@index([transferId])
  @@index([reference])
  @@map("stock_movements")
}

// ============================================================
// WAREHOUSE & INVENTORY MANAGEMENT SYSTEM
// ============================================================

model Warehouse {
  id                   String        @id @default(cuid())
  name                 String
  code                 String        @unique // e.g. "CN-YW", "BY-MS"
  type                 WarehouseType @default(DISTRIBUTION)
  country              String // "China", "Belarus"
  city                 String
  address              String
  contactPerson        String?
  contactPhone         String?
  contactEmail         String?
  isActive             Boolean       @default(true)
  isDefaultProcurement Boolean       @default(false)
  isDefaultSales       Boolean       @default(false)
  notes                String?

  zones             WarehouseZone[]
  stocks            WarehouseStock[]
  movements         StockMovement[]
  sourceTransfers   StockTransfer[]    @relation("SourceTransfers")
  destTransfers     StockTransfer[]    @relation("DestTransfers")
  sourceContainers  Container[]        @relation("SourceContainers")
  destContainers    Container[]        @relation("DestinationContainers")
  orders            Order[]
  purchaseOrders    PurchaseOrder[]
  returnsToSupplier ReturnToSupplier[]
  containerItems    ContainerItem[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  LowStockAlert LowStockAlert[]

  @@index([code])
  @@index([country])
  @@index([isActive])
  @@map("warehouses")
}

model WarehouseZone {
  id             String         @id @default(cuid())
  warehouseId    String
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code           String // e.g. "Z-REC", "Z-STOR", "Z-PICK"
  name           String
  type           ZoneType       @default(STORAGE)
  tempControlled Boolean        @default(false)
  minTemp        Float?
  maxTemp        Float?
  isActive       Boolean        @default(true)
  bays           WarehouseBay[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@map("warehouse_zones")
}

model WarehouseBay {
  id        String          @id @default(cuid())
  zoneId    String
  zone      WarehouseZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  code      String // e.g. "BAY-01"
  name      String?
  aisle     String? // "A1", "A2"
  rack      String? // "R1", "R2"
  level     Int             @default(1)
  maxWeight Float?
  maxCbm    Float?
  isActive  Boolean         @default(true)
  slots     WarehouseSlot[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([zoneId, code])
  @@index([zoneId])
  @@map("warehouse_bays")
}

model WarehouseSlot {
  id        String           @id @default(cuid())
  bayId     String
  bay       WarehouseBay     @relation(fields: [bayId], references: [id], onDelete: Cascade)
  code      String // e.g. "SLOT-01-A"
  name      String?
  barcode   String?          @unique
  maxWeight Float?
  maxCbm    Float?
  isActive  Boolean          @default(true)
  stocks    WarehouseStock[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([bayId, code])
  @@index([bayId])
  @@map("warehouse_slots")
}

model WarehouseStock {
  id           String         @id @default(cuid())
  warehouseId  String
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  slotId       String?
  slot         WarehouseSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  quantity     Int            @default(0) // Physical on-hand in this warehouse/slot
  reservedQty  Int            @default(0) // Reserved for pending customer orders
  avgCost      Float          @default(0) // Weighted average cost per unit
  reorderPoint Int            @default(10)
  maxStock     Int?
  locationCode String? // e.g. "BY-MS-Z-STOR-B01-L2-S01"
  locationPath String? // e.g. "Zone A > Bay 1 > Level 2 > Slot 1"
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
  @@index([slotId])
  @@map("warehouse_stocks")
}

model ContainerItem {
  id                String         @id @default(cuid())
  containerId       String
  container         Container      @relation(fields: [containerId], references: [id], onDelete: Cascade)
  productId         String
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity          Int
  unitCost          Float          @default(0) // Supplier purchase price
  totalCost         Float          @default(0)
  weight            Float? // Total weight (kg)
  cbm               Float? // Total volume (m³)
  source            String         @default("WAREHOUSE") // "WAREHOUSE" or "PO"
  sourcePoId        String?
  sourcePo          PurchaseOrder? @relation(fields: [sourcePoId], references: [id], onDelete: SetNull)
  sourceWarehouseId String?
  sourceWarehouse   Warehouse?     @relation(fields: [sourceWarehouseId], references: [id], onDelete: SetNull)

  // Landed Cost calculation results
  allocatedCost     Float @default(0) // Share of container freight/duties/costs
  landedCostPerUnit Float @default(0) // unitCost + (allocatedCost / quantity)

  // Quality Control on Container Receipt
  receivedQty  Int? // Actual received sound units
  damagedQty   Int?    @default(0) // Damaged goods
  rejectedQty  Int?    @default(0) // Rejected goods
  qualityNotes String? // Notes on damages / defects

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([containerId])
  @@index([productId])
  @@index([sourcePoId])
  @@index([sourceWarehouseId])
  @@map("container_items")
}

model StockTransfer {
  id                     String              @id @default(cuid())
  transferNumber         String              @unique // e.g. "TR-2026-001"
  sourceWarehouseId      String
  sourceWarehouse        Warehouse           @relation("SourceTransfers", fields: [sourceWarehouseId], references: [id])
  destinationWarehouseId String
  destinationWarehouse   Warehouse           @relation("DestTransfers", fields: [destinationWarehouseId], references: [id])
  containerId            String?
  container              Container?          @relation(fields: [containerId], references: [id], onDelete: SetNull)
  status                 TransferStatus      @default(DRAFT)
  requestedBy            String?
  approvedBy             String?
  notes                  String?
  items                  StockTransferItem[]
  movements              StockMovement[]
  shippedAt              DateTime?
  receivedAt             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id           String        @id @default(cuid())
  transferId   String
  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  requestedQty Int
  shippedQty   Int           @default(0)
  receivedQty  Int           @default(0)
  unitCost     Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_items")
}

model ReturnToSupplier {
  id              String                 @id @default(cuid())
  returnNumber    String                 @unique // e.g. "RTS-2026-001"
  supplierId      String
  supplier        Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  status          ReturnStatus           @default(DRAFT)
  totalAmount     Float                  @default(0)
  reason          String
  refundMethod    RefundMethod           @default(STORE_CREDIT)
  notes           String?
  items           ReturnToSupplierItem[]
  shippedAt       DateTime?
  refundedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@map("returns_to_supplier")
}

model ReturnToSupplierItem {
  id          String           @id @default(cuid())
  returnId    String
  return      ReturnToSupplier @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  unitPrice   Float
  totalAmount Float
  reason      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([returnId])
  @@index([productId])
  @@map("return_to_supplier_items")
}

model LowStockAlert {
  id           String      @id @default(cuid())
  warehouseId  String
  warehouse    Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String?
  currentStock Int
  minStock     Int
  status       AlertStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?

  @@index([warehouseId])
  @@index([productId])
  @@index([status])
  @@map("low_stock_alerts")
}

model AdminActivityLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String // CREATE, UPDATE, DELETE, APPROVE, REJECT
  entity    String // Warehouse, Product, Order, Container, PurchaseOrder
  entityId  String?
  changes   Json? // Before/after values
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("admin_activity_logs")
}

// ============================================================================
// B2B PRODUCT REQUEST FOR QUOTE (RFQ) SUBSYSTEM
// ============================================================================

enum ProductQuoteStatus {
  PENDING         // Submitted by customer, awaiting admin review
  UNDER_REVIEW    // Admin is actively working on pricing or revisions
  PRICED          // Admin finished pricing; draft ready
  SENT            // Sent to customer with formal pricing & validUntil date
  ACCEPTED        // Accepted by customer; converted into Order
  REJECTED        // Rejected by customer or declined by admin
  EXPIRED         // Passed validUntil timestamp without customer acceptance
  CANCELLED       // Cancelled by customer before admin sent pricing
}

model ProductQuote {
  id                    String                    @id @default(cuid())
  quoteNumber           String                    @unique // e.g. QUO-2026-0001
  
  // Customer Attribution (Registered or Guest B2B)
  userId                String?
  user                  User?                     @relation("UserProductQuotes", fields: [userId], references: [id], onDelete: SetNull)
  
  guestEmail            String?
  guestName             String?
  guestCompany          String?
  guestPhone            String?
  guestTaxId            String?                   // Tax ID / VAT / UNP number
  
  // Destination & Logistics Context
  shippingCountry       String?                   @default("Belarus")
  shippingCity          String?
  shippingAddress       String?
  targetDeliveryDate    DateTime?
  preferredShippingMode String?                   // e.g., "STANDARD", "EXPRESS", "CONTAINER_RAIL"
  
  // Status & Security
  status                ProductQuoteStatus        @default(PENDING)
  secureToken           String                    @unique @default(cuid()) // Signed secret for passwordless view
  
  // Financial Snapshot
  currency              String                    @default("USD")
  subtotal              Float?                    // Sum of all items lineTotal
  shippingCost          Float?                    // Quoted freight charge
  discountAmount        Float?                    @default(0.0)
  totalAmount           Float?                    // subtotal + shippingCost - discountAmount
  
  // Commercial Terms
  paymentTerms          String?                   @default("PREPAYMENT")
  validUntil            DateTime?
  
  // Communication Notes
  customerNotes         String?
  adminNotes            String?
  internalNotes         String?
  rejectionReason       String?
  
  // Lifecycle Timestamps
  submittedAt           DateTime                  @default(now())
  sentAt                DateTime?
  viewedAt              DateTime?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  
  // Order Fulfillment Link
  order                 Order?                    @relation("ProductQuoteOrder")
  
  // Related Collections
  items                 ProductQuoteItem[]
  statusHistory         ProductQuoteStatusHistory[]
  messages              ProductQuoteMessage[]
  
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([quoteNumber])
  @@index([secureToken])
  @@index([createdAt])
  @@map("product_quotes")
}

model ProductQuoteItem {
  id                    String                    @id @default(cuid())
  quoteId               String
  quote                 ProductQuote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  
  productId             String
  product               Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  productName           String
  productSku            String
  productImage          String?
  
  quantity              Int                       @default(1)
  
  unitPriceRequested    Float?                    // Target price submitted by customer
  unitPriceQuoted       Float?                    // Unit price set by sales admin
  lineDiscountPercent   Float?                    @default(0.0)
  lineTotal             Float?                    // quantity * unitPriceQuoted * (1 - discount/100)
  
  sourceWarehouseId     String?
  isBackorder           Boolean                   @default(false)
  leadTimeDays          Int?                      @default(0)
  
  customerNotes         String?
  adminNotes            String?
  sortOrder             Int                       @default(0)
  
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([quoteId])
  @@index([productId])
  @@map("product_quote_items")
}

model ProductQuoteStatusHistory {
  id                    String                    @id @default(cuid())
  quoteId               String
  quote                 ProductQuote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  
  fromStatus            ProductQuoteStatus?
  toStatus              ProductQuoteStatus
  
  changedByUserId       String?
  changedByRole         String                    // "CUSTOMER", "ADMIN", "SYSTEM"
  reason                String?
  
  createdAt             DateTime                  @default(now())

  @@index([quoteId])
  @@index([createdAt])
  @@map("product_quote_status_history")
}

model ProductQuoteMessage {
  id                    String                    @id @default(cuid())
  quoteId               String
  quote                 ProductQuote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  
  senderType            String                    // "CUSTOMER" or "ADMIN"
  senderId              String?
  senderName            String
  
  message               String
  attachments           String?                   // JSON array of file URLs
  
  createdAt             DateTime                  @default(now())

  @@index([quoteId])
  @@index([createdAt])
  @@map("product_quote_messages")
}

