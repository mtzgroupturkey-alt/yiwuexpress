generator client {
  provider      = "prisma-client-js"
  // Ubuntu 24.04 ships glibc + OpenSSL 3.0. Pinning debian-openssl-3.0.x makes
  // `prisma generate` produce a Linux-compatible engine so `next build` works
  // on the production server (not just the dev machine's `native` engine).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String
  name               String
  companyName        String?
  businessType       String?
  taxId              String?
  country            String?
  phone              String?
  profilePhoto       String? // Profile photo URL or base64
  role               String    @default("USER") // USER, SUPPLIER, ADMIN
  roleId             String?
  resetToken         String?
  resetTokenExpiry   DateTime?
  isActive           Boolean   @default(true)
  isVerified         Boolean   @default(false)
  userType           String    @default("RETAIL") // "RETAIL", "WHOLESALE", "BOTH"
  verificationStatus String    @default("UNVERIFIED") // "UNVERIFIED", "PENDING", "APPROVED", "REJECTED", "DOCUMENTS_REQUIRED"
  verificationNotes  String?
  verifiedAt         DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Supplier reference (only for SUPPLIER role)
  supplierId      String?          @unique
  supplierProfile SupplierProfile? @relation(fields: [supplierId], references: [id])

  company            CompanyInfo?
  quotes             Quote[]
  productQuotes      ProductQuote[]         @relation("UserProductQuotes")
  permissionRole     PermissionRole?        @relation(fields: [roleId], references: [id])
  customPermissions  UserPermission[]
  activityLogs       ActivityLog[]
  adminActivityLogs  AdminActivityLog[]
  addresses          Address[]
  cart               Cart?
  emailLogs          EmailLog[]
  notifications      Notification[]
  orders             Order[]
  returns            Return[]
  wholesaleInquiries WholesaleInquiry[]
  wishlistItems      WishlistItem[]
  reviews            Review[]
  reviewReplies      ReviewReply[]
  verificationDocs   VerificationDocument[]
  contractPrices     ContractPrice[]
  targetedPurchaseOrders PurchaseOrder[] @relation("TargetCustomerPOs")

  @@index([email])
  @@index([role])
  @@index([verificationStatus])
}

model Service {
  id           String               @id @default(cuid())
  name         String
  slug         String               @unique
  description  String?
  price        Float
  duration     String?
  coverage     String?
  type         String
  image        String?
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  quotes       Quote[]
  translations ServiceTranslation[]

  @@map("Service")
}

// Expand-and-Contract: per-locale service copy. Legacy `name`/`description`/
// `coverage`/`duration` on Service remain the source of truth until read paths
// migrate (Phase 3+).
model ServiceTranslation {
  id          String   @id @default(cuid())
  serviceId   String
  locale      String
  name        String
  description String?
  coverage    String?
  duration    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
  @@index([locale])
  @@map("service_translations")
}

model Quote {
  id          String    @id @default(cuid())
  userId      String
  serviceId   String
  serviceType String
  weight      Float?
  dimensions  String?
  origin      String
  destination String
  price       Float?
  validUntil  DateTime?
  status      String    @default("PENDING")
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  service     Service   @relation(fields: [serviceId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanyInfo {
  id            String   @id @default(cuid())
  userId        String   @unique
  name          String
  address       String?
  phone         String?
  email         String?
  licenseNumber String?
  taxId         String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSettings {
  id                    String  @id @default(cuid())
  // Enforces the intended singleton: exactly one row, addressable deterministically
  // via findUnique/upsert on singletonKey. See migration add_system_settings_singleton_key.
  singletonKey          String  @unique @default("SINGLETON")
  companyName           String  @default("Global Trade")
  siteTagline           String?
  companyAddress        String?
  companyPhone          String?
  companyEmail          String?
  companyWebsite        String?
  businessLicense       String?
  taxRegistrationNumber String?
  companyDescription    String?
  companyLogo           String?
  companyLogoHeight     Int     @default(40)
  companyFavicon        String?
  primaryColor          String  @default("#1a3a5c")
  accentColor           String  @default("#c9a84c")
  currency              String  @default("USD")
  timezone              String  @default("Asia/Shanghai")
  language              String  @default("en")
  emailNotifications    Boolean @default(true)
  smsNotifications      Boolean @default(false)
  maintenanceMode       Boolean @default(false)
  storeMode             String  @default("WHOLESALE") // WHOLESALE, RETAIL, BOTH
  facebookUrl           String?
  twitterUrl            String?
  linkedinUrl           String?
  instagramUrl          String?
  wechatId              String?
  whatsappNumber        String?

  // Store Front & Header Customizations
  storeHours            String? @default("08:00 – 23:00")
  freeShippingThreshold Float?  @default(35.00)
  announcementTicker    String?

  // Multi-Warehouse Routing & Channels
  defaultSalesWarehouseId       String?  @default("cmu149zqd0007w4gois6udmjc")
  defaultProcurementWarehouseId String?  @default("cmu12i65n0000w43wy8bb90uz")

  // Retail (B2C) Channel Settings
  retailEnabled                 Boolean  @default(true)
  showBackorderOption           Boolean  @default(true)
  backorderLeadTimeDays         Int      @default(28)

  // Wholesale (B2B) Channel & RFQ Settings
  wholesaleEnabled              Boolean  @default(true)
  wholesaleApprovalRequired     Boolean  @default(false)
  wholesaleDefaultMoq           Int      @default(10)
  wholesaleDiscountPercent      Float?   @default(15.0)
  rfqEnabled                    Boolean  @default(true)
  rfqModel                      String   @default("RFQ") // "RFQ" (Request for Quote) or "INSTANT" (Direct Checkout)
  rfqDefaultExpiryDays          Int      @default(7)
  rfqAllowGuestSubmissions      Boolean  @default(true)
  rfqAutoSuggestCatalogPrice    Boolean  @default(true)

  // Inventory Reservation Engine
  reservationExpiryHours        Int      @default(24)

  // AI Translation & Gateway Settings (OpenAI-compatible)
  openaiApiKey      String?
  openaiBaseUrl     String? @default("https://llm.gcat.ir/v1")
  openaiModel       String? @default("gpt-4o")
  primaryAiProvider String? @default("openai")

  // Secondary Fallback API Keys
  openrouterApiKey  String?
  geminiApiKey      String?
  deepseekApiKey    String?
  qwenApiKey        String?
  kimiApiKey        String?
  cerebrasApiKey    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations SystemSettingTranslation[]

  @@map("system_settings")
}

// Expand-and-Contract: per-locale system/company setting text blocks. The
// `key` disambiguates which setting field is translated (e.g. "companyName",
// "companyDescription", "companyAddress"). The legacy columns on SystemSettings
// remain the English source of truth / fallback. Unique per (setting, locale, key).
model SystemSettingTranslation {
  id              String   @id @default(cuid())
  systemSettingId String
  locale          String
  key             String
  value           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  systemSetting SystemSettings @relation(fields: [systemSettingId], references: [id], onDelete: Cascade)

  @@unique([systemSettingId, locale, key])
  @@index([locale])
  @@map("system_setting_translations")
}

model ContactLocation {
  id           String                       @id @default(cuid())
  type         String                       @default("HUB") // HEADQUARTERS, HUB
  city         String
  address      String?
  phone        String?
  email        String?
  hours        String?
  sortOrder    Int                          @default(0)
  isActive     Boolean                      @default(true)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  translations ContactLocationTranslation[]

  @@map("contact_locations")
}

// Expand-and-Contract: per-locale contact location copy. Legacy `city`/`address`/
// `hours` on ContactLocation remain the source of truth until read paths migrate.
model ContactLocationTranslation {
  id                String   @id @default(cuid())
  contactLocationId String
  locale            String
  city              String
  address           String?
  hours             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contactLocation ContactLocation @relation(fields: [contactLocationId], references: [id], onDelete: Cascade)

  @@unique([contactLocationId, locale])
  @@index([locale])
  @@map("contact_location_translations")
}

model PermissionRole {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  id        String         @id @default(cuid())
  roleId    String
  resource  String
  canView   Boolean        @default(false)
  canCreate Boolean        @default(false)
  canEdit   Boolean        @default(false)
  canDelete Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  role      PermissionRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource])
}

model UserPermission {
  id        String   @id @default(cuid())
  userId    String
  resource  String
  canView   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource])
}

model Country {
  id                 String               @id @default(cuid())
  code               String               @unique
  name               String
  currency           String
  currencySymbol     String
  flag               String?
  shippingMethods    Json
  customsRules       Json
  paymentMethods     String[]
  deliverySLA        String
  restrictedProducts String[]
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  orders             Order[]
  wholesaleInquiries WholesaleInquiry[]
  translations       CountryTranslation[]

  @@map("countries")
}

// Expand-and-Contract: per-locale country name. Legacy `name` on Country remains
// the source of truth (and English fallback) until read paths migrate.
model CountryTranslation {
  id        String   @id @default(cuid())
  countryId String
  locale    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, locale])
  @@index([locale])
  @@map("country_translations")
}

model Category {
  id                 String                @id @default(cuid())
  name               String                @unique
  slug               String                @unique
  description        String?
  image              String?
  parentId           String?
  level              Int                   @default(1)
  displayOrder       Int                   @default(0)
  menuOrder          Int                   @default(0)
  isActive           Boolean               @default(true)
  showInMenu         Boolean               @default(true)
  isFeatured         Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  icon               String?
  breadcrumbSettings BreadcrumbSetting[]
  parent             Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           Category[]            @relation("CategoryHierarchy")
  attributes         CategoryAttribute[]
  products           Product[]
  translations       CategoryTranslation[]

  @@map("categories")
}

// Expand-and-Contract: per-locale category copy. Legacy `name`/`description`
// on Category remain the source of truth until read paths migrate (Phase 3+).
model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  locale      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
  @@map("category_translations")
}

model Product {
  id                    String                 @id @default(cuid())
  sku                   String                 @unique
  name                  String
  slug                  String                 @unique
  description           String?
  categoryId            String?
  price                 Float
  compareAtPrice        Float?
  costPrice             Float?
  purchaseCurrency      String? // Currency used for purchases (CNY)
  purchasePrice         Float? // Price in purchase currency
  prices                Json? // Multi-currency prices: { "USD": 150.00, "CNY": 1080.00 }
  images                String[]
  videos                String[]               @default([])
  thumbnail             String?
  stock                 Int                    @default(0)
  lowStockThreshold     Int                    @default(10)
  hsCode                String?
  weightKg              Float
  dimensions            Json?
  declaredCustomsValue  Float?
  countryOfOrigin       String                 @default("China")
  material              String?
  fragile               Boolean                @default(false)
  exportRestricted      Boolean                @default(false)
  dangerousGoods        Boolean                @default(false)
  batteryIncluded       Boolean                @default(false)
  requiredExportDocs    String[]
  minOrderQty           Int                    @default(1)
  wholesalePrice        Float?
  metaTitle             String?
  metaDescription       String?
  isActive              Boolean                @default(true)
  availableForRetail    Boolean                @default(true)
  availableForWholesale Boolean                @default(true)
  isFeatured            Boolean                @default(false)
  featuredOrder         Int                    @default(999)
  isNewArrival          Boolean                @default(false)
  newArrivalOrder       Int                    @default(999)
  isFlashSale           Boolean                @default(false)
  flashSaleOrder        Int                    @default(999)
  flashSalePrice        Float?
  flashSaleStart        DateTime?
  flashSaleEnd          DateTime?
  flashSaleStock        Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  attributeValues       AttributeValue[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  variants              ProductVariant[]
  category              Category?              @relation(fields: [categoryId], references: [id])
  suppliers             ProductSupplier[]
  purchaseOrderItems    PurchaseOrderItem[]
  wishlistItems         WishlistItem[]
  reviews               Review[]
  translations          ProductTranslation[]
  contractPrices        ContractPrice[]
  stockMovements        StockMovement[]
  warehouseStocks       WarehouseStock[]
  containerItems        ContainerItem[]
  lowStockAlerts        LowStockAlert[]
  stockTransferItems    StockTransferItem[]
  returnSupplierItems   ReturnToSupplierItem[]
  productQuoteItems     ProductQuoteItem[]

  @@map("products")
}

// Expand-and-Contract: per-locale product copy. Legacy `name`/`description`
// on Product remain the source of truth until read paths migrate (Phase 3+).
model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String
  locale      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
  @@map("product_translations")
}

model Order {
  id                 String    @id @default(cuid())
  orderNumber        String    @unique
  userId             String
  customerName       String
  customerEmail      String
  customerPhone      String
  companyName        String?
  shippingAddress    String
  shippingCity       String
  shippingState      String?
  shippingPostalCode String
  shippingCountryId  String
  billingAddress     String?
  billingCity        String?
  billingState       String?
  billingPostalCode  String?
  billingCountry     String?
  status             String    @default("PENDING")
  mode               String    @default("RETAIL") // "RETAIL" | "WHOLESALE"
  paymentMethod      String
  paymentStatus      String    @default("UNPAID")
  paidAt             DateTime?
  subtotal           Float
  shippingFee        Float
  tax                Float     @default(0)
  discount           Float     @default(0)
  total              Float
  currency           String    @default("USD") // Sales currency
  exchangeRate       Float? // Rate used at time of order
  purchaseCost       Float? // Cost in base currency
  profit             Float? // Profit in base currency
  profitMargin       Float? // Profit percentage

  // Carrier type: COMPANY or CUSTOMER
  carrierType             String  @default("COMPANY")
  customerCarrier         String?
  customerCarrierContact  String?
  customerCarrierTracking String?
  customerCarrierNotes    String?

  carrier           String?
  trackingNumber    String?
  shippingMethod    String?
  shippingCost      Float?
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  trackingHistory   Json[]
  customsStatus     String?
  customsDocs       Json?

  // Container relation
  containerId     String?
  container       Container? @relation(fields: [containerId], references: [id])
  containerNumber String?

  // Warehouse & Sales Flow
  warehouseId          String?
  warehouse            Warehouse?      @relation(fields: [warehouseId], references: [id])
  reservationExpiresAt DateTime?
  salesType            OrderSalesType  @default(RETAIL)
  isDirectContainer    Boolean         @default(false)
  stockMovements       StockMovement[]

  customerNotes    String?
  adminNotes       String?
  hasException     Boolean           @default(false)
  exceptionType    String?
  exceptionNotes   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  emailLogs        EmailLog[]
  exceptions       OrderException[]
  items            OrderItem[]
  shippingCountry  Country           @relation(fields: [shippingCountryId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  returns          Return[]
  customerPayments CustomerPayment[]
  linkedPurchaseOrder PurchaseOrder? @relation("POLinkedOrder")
  singleContainer Container[] @relation("ContainerSingleOrder")
  quoteId          String?           @unique
  productQuote     ProductQuote?     @relation("ProductQuoteOrder", fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([containerId])
  @@map("orders")
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  productId         String
  variantId         String?
  productName       String
  productSku        String
  productImage      String?
  variantAttributes Json?
  quantity          Int
  price             Float
  total             Float
  status            String          @default("PENDING")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])
  variant           ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model OrderException {
  id          String    @id @default(cuid())
  orderId     String
  type        String
  description String
  status      String    @default("OPEN")
  resolution  String?
  createdBy   String?
  resolvedBy  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime  @updatedAt
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_exceptions")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  mode      String     @default("RETAIL") // "RETAIL" | "WHOLESALE"
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  mode      String          @default("RETAIL") // "RETAIL" | "WHOLESALE"
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model WholesaleInquiry {
  id                   String    @id @default(cuid())
  inquiryNumber        String    @unique
  userId               String
  companyName          String
  businessType         String
  country              String
  countryId            String?
  products             Json
  paymentTerms         String
  shippingTerms        String
  preferredShipping    String
  requiredDeliveryDate DateTime?
  targetPrice          Float?
  estimatedOrderValue  Float?
  status               String    @default("INQUIRY_SUBMITTED")
  quotedPrice          Float?
  quotedBy             String?
  quotedAt             DateTime?
  quoteValidUntil      DateTime?
  quoteNotes           String?
  negotiationHistory   Json[]
  invoiceNumber        String?
  invoiceUrl           String?
  invoicedAt           DateTime?
  convertedToOrderId   String?
  convertedAt          DateTime?
  customerNotes        String?
  adminNotes           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  shippingCountry      Country?  @relation(fields: [countryId], references: [id])
  user                 User      @relation(fields: [userId], references: [id])

  @@map("wholesale_inquiries")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String?
  fullName     String
  phone        String
  company      String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  country      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  sku                String              @unique
  attributes         Json
  price              Float
  comparePrice       Float?
  costPrice          Float?
  stock              Int                 @default(0)
  lowStockThreshold  Int                 @default(10)
  images             String[]
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attributeValues    AttributeValue[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  tieredPrices       TieredPrice[]
  purchaseOrderItems PurchaseOrderItem[] // NEW
  stockMovements     StockMovement[]

  @@map("product_variants")
}

model TieredPrice {
  id          String         @id @default(cuid())
  variantId   String
  minQuantity Int
  maxQuantity Int?
  price       Float
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("tiered_prices")
}

model Return {
  id               String    @id @default(cuid())
  orderId          String
  userId           String
  returnNumber     String    @unique
  reason           String
  description      String?
  images           String[]
  items            Json
  status           String    @default("REQUESTED")
  returnCarrier    String?
  returnTracking   String?
  returnShippedAt  DateTime?
  returnReceivedAt DateTime?
  refundAmount     Float?
  refundMethod     String?
  refundReason     String?
  refundedAt       DateTime?
  adminNotes       String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id])

  @@map("returns")
}

model EmailLog {
  id          String    @id @default(cuid())
  orderId     String?
  userId      String?
  recipient   String
  subject     String
  template    String
  content     String
  status      String
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  order       Order?    @relation(fields: [orderId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@map("email_logs")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("activity_logs")
}

model HeroSlide {
